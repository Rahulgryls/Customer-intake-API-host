                "customer-intake",
                "v1",
                "customers",
                "{{customerId}}",
                "transactions"
              ],
              "query": []
            },
            "description": "Plain GET returns every account"
          }
        },
        {
          "name": "Get transactions (filtered, 200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}",
                "description": "Optional trace id"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer-intake/v1/customers/{{customerId}}/transactions?iban=NL62RABO0300065432&dateFrom=2026-01-01&dateTo=2026-03-31&bookingStatus=BOOKED&pageNumber=1&pageSize=200",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer-intake",
                "v1",
                "customers",
                "{{customerId}}",
                "transactions"
              ],
              "query": [
                {
                  "key": "iban",
                  "value": "NL62RABO0300065432",
                  "disabled": false
                },
                {
                  "key": "dateFrom",
                  "value": "2026-01-01",
                  "disabled": false
                },
                {
                  "key": "dateTo",
                  "value": "2026-03-31",
                  "disabled": false
                },
                {
                  "key": "bookingStatus",
                  "value": "BOOKED",
                  "disabled": false
                },
                {
                  "key": "pageNumber",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "pageSize",
                  "value": "200",
                  "disabled": false
                }
              ]
            },
            "description": "Only iban is actually filtered by the mock; the rest are echoed"
