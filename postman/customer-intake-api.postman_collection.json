    {
      "name": "Mock APIs (custom)",
      "item": [
        {
          "name": "List records",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}",
                "description": "Optional trace id"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer-intake/v1/mock/{{mockSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer-intake",
                "v1",
                "mock",
                "{{mockSlug}}"
              ],
              "query": []
            },
            "description": "List stored records"
          }
        },
        {
          "name": "Get record",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}",
                "description": "Optional trace id"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer-intake/v1/mock/{{mockSlug}}/{{recordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer-intake",
                "v1",
                "mock",
                "{{mockSlug}}",
                "{{recordId}}"
              ],
              "query": []
            },
            "description": "Get one record"
          }
        },
        {
          "name": "Create/update record",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}",
                "description": "Optional trace id"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer-intake/v1/mock/{{mockSlug}}/{{recordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer-intake",
                "v1",
                "mock",
                "{{mockSlug}}",
                "{{recordId}}"
              ],
              "query": []
            },
            "description": "Store any JSON",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exampleField\": \"value\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete record",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}",
                "description": "Optional trace id"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer-intake/v1/mock/{{mockSlug}}/{{recordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer-intake",
                "v1",
                "mock",
                "{{mockSlug}}",
                "{{recordId}}"
              ],
              "query": []
            },
            "description": "Delete one record"
          }
        }
