{
  "info": {
    "name": "Customer Intake API",
    "description": "Customer Details, Risk Profile and Transaction History APIs plus mock-API and utility endpoints. Auth: HTTP Basic (collection-level, uses {{username}}/{{password}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "username",
      "value": "demo"
    },
    {
      "key": "password",
      "value": "demo123"
    },
    {
      "key": "customerId",
      "value": "110023456"
    },
    {
      "key": "mockSlug",
      "value": "my-api"
    },
    {
      "key": "recordId",
      "value": "sample"
    }
  ],
  "item": [
    {
      "name": "API-01 Customer Details",
      "item": [
        {
          "name": "Get customer (org, 200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}",
                "description": "Optional trace id"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer-intake/v1/customers/{{customerId}}?idType=RABO_CUSTOMER_ID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer-intake",
                "v1",
                "customers",
                "{{customerId}}"
              ],
              "query": [
                {
                  "key": "idType",
                  "value": "RABO_CUSTOMER_ID",
                  "disabled": false
                }
              ]
            },
            "description": "Organisation - De Groot Kaashandel B.V."
          }
        },
