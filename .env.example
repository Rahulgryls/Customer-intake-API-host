PORT=3000
# username:password pairs, comma-separated - give each consuming app OR each teammate
# using the admin portal their own pair, so "who created this API" means something real.
BASIC_AUTH_USERS=demo:demo123,partnerapp:s3cret456,alex:alexpass456

# Optional: usernames (from BASIC_AUTH_USERS above) who can manage/delete ANY custom API
# in the admin portal, not just the ones they created. Defaults to just the first
# username in BASIC_AUTH_USERS if left unset - so by default only the primary account
# is an admin, and everyone else can only edit/delete what they created.
ADMIN_USERS=demo
